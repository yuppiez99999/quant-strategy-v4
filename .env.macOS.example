# ============================================================
# 量化策略系统 v5.10 — macOS 环境配置模板
# ============================================================
# 使用方法: 复制此文件为 .env 并填入你的真实配置
# ============================================================

# ============================================================
# 1. 数据源 API Key（必填）
# ============================================================
WIND_API_KEY=your_wind_api_key_here
IFIND_TOKEN=your_ifind_token_here
TS_TOKEN=your_tushare_token_here
VOLCENGINE_API_KEY=your_volcengine_key_here

# ============================================================
# 2. 路径配置（macOS 默认路径）
# ============================================================
MODEL_DIR=~/models/Qwen
LLAMA_SERVER_EXE=~/models/llama_cpp_bin/llama-server
WIND_SKILL_DIR=~/.agents/skills/wind-mcp-skill
YIZHAO_ROOT_DIR=~/YiZhao-FinDataSet
YIZHAO_FILTERED_DIR=./data/yizhao_filtered

# ============================================================
# 3. 字体路径（macOS 字体）
# ============================================================
FONT_SIMHEI_PATH=/Library/Fonts/SimHei.ttf
FONT_SIMSUN_PATH=/Library/Fonts/SimSun.ttc
FONT_MSYH_PATH=/Library/Fonts/Microsoft YaHei.ttc

# ============================================================
# 4. 系统配置
# ============================================================
REPORT_OUTPUT_DIR=./每日报告归档
LOG_DIR=./logs
DATA_DIR=./data
CACHE_DIR=./data/cache
LOG_LEVEL=INFO

# ============================================================
# 5. 本地 LLM 配置
# ============================================================
LOCAL_LLM_MODEL_PATH=~/models/Qwen/Qwen2.5-1.5B-Instruct/qwen2.5-1.5b-instruct-q4_k_m.gguf

# ============================================================
# 6. Streamlit UI 配置
# ============================================================
STREAMLIT_PYTHON=python3

# ============================================================
# macOS 字体安装说明:
# 1. 从 Windows 复制字体到 macOS: /Library/Fonts/
# 2. 或使用 brew 安装:
#    brew install homebrew/cask-fonts/font-simhei
#    brew install homebrew/cask-fonts/font-simsun
#    brew install homebrew/cask-fonts/font-microsoft-yahei
# ============================================================