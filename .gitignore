.pytest_cache/
.coverage
.tox/
.nox/

# ── 12. 嵌套 Git 仓库 ───────────────────────────────
Shadowbroker/

# ── 13. 归档数据 ────────────────────────────────────
_archive*/
_archive_*/
_archive_20260620/
每日报告归档/

# ── 14. 投资计划与个人记录（配置级） ──────────────────
config/stop_loss_*.yaml
config/portfolio.yaml
config/portfolio_v3.yaml
config/watchlist.yaml
2026年交易计划*.md
!2026年交易计划_优化版_v2.md.example

# ── 15. PDF 报告（可能含持仓信息） ───────────────────
*.pdf
!template_*.pdf
!example_*.pdf

# ── 16. 财务分析结果（个人敏感） ────────────────────
玻璃基板投资标的分析.txt
training_data.csv
训练数据.csv

# ── 17. Shadowbroker 子项目 ─────────────────────────
Shadowbroker/
Shadowbroker/**

# ============================================================
# 使用说明：
# 1. .env / .env.local 包含 API Key，禁止上传
# 2. data/positions.json 包含真实持仓，禁止上传
# 3. config/portfolio.yaml 包含个人投资策略，禁止上传
# 4. 复制 .env.example 模板供协作者使用
# 5. 上传前运行：git status 确认无敏感文件
# 6. 验证命令：git check-ignore -v .env
# ============================================================

