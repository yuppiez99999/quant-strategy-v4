# ============================================================
# 量化策略系统 v5.6 - .gitignore
# 用于 GitHub 上传，隐藏所有敏感文件
# 保留：核心代码、配置模板、文档
# 排除：API 密钥、真实持仓、个人交易数据
# ============================================================

# ── 1. 敏感凭证（绝对不能提交） ─────────────────────
.env
.env.local
.env.*.local
*.env.local
config/*.private.json
config/settings.yaml
config/credentials.json
config/api_keys.json
config/secrets.yaml
config/tokens.json
config/account_info.json
config/broker_config.json
config/trading_account.*
*.key
*.pem
*.p12
*.pkcs12
*.token
*.credential

# ── 2. 真实账户持仓与交易数据（最敏感） ──────────────
config/positions.json
data/positions.json
config/price_history.jsonl
config/price_*.jsonl
data/pnl_*.json
data/yizhao/
data/*_pnl_*.json
data/*_positions_*.json
data/*_account_*.json
data/*_balance_*.json
data/yizhao_subset.jsonl
data/yizhao/stats.json

# ── 3. 报告与日志（避免泄漏交易细节） ───────────────
reports/
logs/
ui/logs/
signals/
trade_logs/
daily_report.txt
*.log
*.log.*

# ── 4. Excel 持仓文件（包含实际仓位） ───────────────
*.xlsx
*.xls
!data_extraction_*.xlsx
!template_*.xlsx
!example_*.xlsx
!sample_*.xlsx

# ── 5. 模型与大文件 ─────────────────────────────────
models/*.pth
models/*.pt
models/*.bin
models/*.onnx
*.pth
*.pt
*.bin
*.onnx
*.pkl
*.joblib
data/*.parquet
*.parquet
*.h5
*.hdf5

# ── 6. 缓存与临时数据 ───────────────────────────────
cache/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.cache
*.tmp
*.bak
*.old
*.swp
*.swo
*~
临时数据/
temp/
.ECC/
.local/
.parquet-cache/
*.parquet.tmp
help_output.txt
test_output.txt
rebalance_output.txt

# ── 7. 虚拟环境 ─────────────────────────────────────
.venv/
venv/
env/
ENV/
.venv3/
pythonenv3/

# ── 8. 构建产物 ─────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
htmlcov/

# ── 9. IDE / 编辑器 ─────────────────────────────────
