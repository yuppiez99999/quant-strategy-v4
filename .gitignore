verify_skills.py
update_claude_version.py

# ── 10. 测试和临时脚本 ────────────────────────────────
test_*.py
_quick_test.py
_test_models.py

# ── 11. 批处理和脚本文件（可能含敏感路径） ─────────────
*.bat
*.ps1
!README*.md

# ── 12. 配置文件（含策略和账户信息） ──────────────────
config/rebalance.yaml
config/risk.yaml
investment_report.json
investment_report.md
requirements.txt
config/settings.yaml
config/portfolio.yaml
config/portfolio_v3.yaml
config/watchlist.yaml
config/stop_loss_*.yaml
config/rebalance_stop_loss_*.json

# ── 13. 系统文件 ────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── 14. 测试与覆盖率 ────────────────────────────────
.pytest_cache/
.coverage
.tox/
.nox/

# ── 15. 嵌套 Git 仓库 ───────────────────────────────
Shadowbroker/

# ── 16. 归档数据 ────────────────────────────────────
_archive*/
_archive_*/
_archive_20260620/
每日报告归档/

# ── 17. 投资计划与个人记录（配置级） ──────────────────
2026年交易计划*.md
!2026年交易计划_优化版_v2.md.example
build_plan_100w.json
build_plan_100w.md
build_plan_100w.py
