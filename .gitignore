# ── 18. PDF 报告（可能含持仓信息） ───────────────────
*.pdf
!template_*.pdf
!example_*.pdf

# ── 19. 财务分析结果（个人敏感） ────────────────────
玻璃基板投资标的分析.txt
training_data.csv
训练数据.csv

# ── 20. Shadowbroker 子项目 ─────────────────────────
Shadowbroker/
Shadowbroker/**

# ── 21. 超算 SSH 密钥 ───────────────────────────────
*RsaKey*.txt
*private*.txt
*key*.txt

# ── 22. 注册表文件 ──────────────────────────────────
*.reg

# ── 23. 训练日志与临时文件 ──────────────────────────
train_log_*.txt
*_log_full.txt
*_log_err.txt
*_train_log*.txt
\# Phase 2*.txt

# ── 24. 模型训练输出（可重新生成） ──────────────────
model_train/output/
model_train/models/

# ============================================================
# 允许保留的模板文件（不应被忽略）
# ============================================================
!config/positions_template.json
!config/portfolio_template.yaml
!.env.example
!.env.template
!_test_ml.py

# ============================================================
# 使用说明：
# 1. .env / .env.local 包含 API Key，禁止上传
# 2. config/positions.json 包含真实持仓，禁止上传
# 3. config/portfolio.yaml 包含个人投资策略，禁止上传
# 4. 复制 .env.example 或 .env.template 模板供协作者使用
# 5. 上传前运行：git status 确认无敏感文件
# 6. 验证命令：git check-ignore -v .env
# ============================================================
