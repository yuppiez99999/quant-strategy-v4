# ============================================================
# 量化策略系统 v5.6 - 环境变量模板
# 使用方式: 复制此文件为 .env 并填入真实密钥
# ============================================================

# ── 数据源 API Key ──────────────────────────────────────

# Wind MCP API Key（P0 主数据源）
WIND_API_KEY=your_wind_api_key_here

# iFinD MCP Token（P1 备选数据源）
IFIND_TOKEN=your_ifind_token_here

# Tushare Token（国内期货/CPI数据）
TS_TOKEN=your_ts_token_here

# ── AI/LLM API Key ──────────────────────────────────────

# 豆包 API Key (Volcengine) - 用于 AI 决策和分析
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_MODEL=doubao-speed-32k
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3/responses

# DeepSeek V4 Pro API（LLM决策引擎）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GLM-5 模式 (api/local/ollama/local_gguf)
GLM5_MODE=api

# ── AI Hedge Fund 配置 ──────────────────────────────────

# 推荐使用本地 Ollama Qwen2.5 模型（最快响应）
# 前提: 运行命令 ollama pull qwen2.5:14b
AI_HEDGE_MODEL=qwen2.5:14b
AI_HEDGE_PROVIDER=Ollama
OLLAMA_BASE_URL=http://localhost:11434

# 备选: 如果用 vLLM 运行 Qwen2.5 (OpenAI 兼容接口)
# AI_HEDGE_MODEL=qwen2.5-14b-instruct
# AI_HEDGE_PROVIDER=OpenAI
# OPENAI_API_KEY=not-needed
# OPENAI_API_BASE=http://localhost:8000/v1

# ── 系统配置 ──────────────────────────────────────────

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 报告输出目录
REPORT_OUTPUT_DIR=./每日报告归档

# ── 数据源优先级配置 ──────────────────────────────────

# 主数据源 (wind/ifind/akshare/sina)
DATA_SOURCE_PRIMARY=wind

# 备选数据源
DATA_SOURCE_SECONDARY=ifind

# ── 回测配置 ──────────────────────────────────────────

# 默认回测开始日期
BACKTEST_START_DATE=2024-01-01

# 默认回测结束日期
BACKTEST_END_DATE=2026-06-30

# ── 风控配置 ──────────────────────────────────────────

# 最大单日回撤限制
MAX_DAILY_DRAWDOWN=0.05

# 最大总回撤限制
MAX_TOTAL_DRAWDOWN=0.15

# ── 再平衡配置 ────────────────────────────────────────

# 再平衡阈值（权重偏差超过此值触发再平衡）
REBALANCE_THRESHOLD=0.05

# 最小再平衡间隔（天数）
REBALANCE_MIN_INTERVAL=5

# ============================================================
# 敏感信息说明:
# 1. 以上所有 API Key 均为敏感信息，禁止提交到代码仓库
# 2. 请使用环境变量或 .env 文件管理密钥
# 3. .env 文件已在 .gitignore 中配置，不会被 git 追踪
# 4. 部署时使用安全的密钥管理服务（如 Vault、Key Vault 等）
# ============================================================
